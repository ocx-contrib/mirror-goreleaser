# goreleaser/tests/smoke.star — stable across upstream goreleaser releases.
# Asserts the contract (exit codes, version shape, a real on-disk side effect,
# and both directions of config validation), never help/version prose.
# See ocx.mirror testing-practices.md.
#
# goreleaser is a release-automation tool. Its headline verbs — `build` and
# `release` — need a real git repository, a Go toolchain and network access, so
# none of them is reachable hermetically. What IS hermetic and genuinely
# functional is the pair underneath:
#
#   goreleaser init    generates .goreleaser.yaml + .gitignore in the CWD, and
#                      REFUSES to overwrite an existing one
#   goreleaser check   parses and validates config files, exit 0 / non-zero
#
# Measured on 2.16.0, 2.17.0 and 2.17.1, and inside bare ubuntu:24.04 /
# alpine:3.20 / fedora:40 with no `git` on PATH: every verb below exits as
# asserted without git. `init` writes `.gitignore` itself rather than shelling
# out, and the configs written here set `release.disable: true`, which skips
# the scm pipe — the only git-touching path. (`goreleaser check` on the
# DEFAULT config generated by `init` DOES fail outside a repository, with
# `scm releases: current folder is not a git repository`; that path is
# deliberately not exercised, which is what lets the container legs run on
# stock images with nothing provisioned.)

GORELEASER = "goreleaser.exe" if ocx.target_platform.os == ocx.os.Windows else "goreleaser"

PROJ = "proj"


def cfg(name):
    # Minimal config that validates with NO git repository present. Both
    # `project_name` and `release.disable` are load-bearing: without the former
    # goreleaser reds with "couldn't guess project_name", without the latter it
    # reds with "scm releases: current folder is not a git repository".
    return ("version: 2\n" +
            "project_name: " + name + "\n" +
            "release:\n" +
            "  disable: true\n" +
            "builds:\n" +
            "  - id: " + name + "\n" +
            "    skip: true\n")


# ── Tier 1 + 2: liveness on the composed PATH + version SHAPE ───────────────
# `--version` prints an ASCII banner followed by a GitVersion/GoVersion block,
# on stdout, exit 0. The digits are the contract; the banner and the vendor
# prose around them are not.
r_version = ocx.run(GORELEASER, "--version")
expect.ok(r_version)
expect.matches(r_version.stdout, r"\d+\.\d+\.\d+")

# … and the binary in this bundle is built for the platform the bundle CLAIMS.
# goreleaser prints `Platform:  <goos>/<goarch>`, and Go's GOOS/GOARCH spellings
# are exactly the OCI strings `str(ocx.target_platform)` produces. This is the
# one bug class the spec-side platform-resolution gate cannot see from outside:
# a regex that resolved the WRONG artifact into the right bundle would satisfy
# every other assertion here. It is worth more than usual for this package —
# `goreleaser_Darwin_all.tar.gz` (a universal fat binary) and a `.sbom.json`
# sidecar per archive are both live ambiguity traps in the upstream asset set.
expect.contains(r_version.stdout, str(ocx.target_platform))

# ── Tier 3a: a real, observable on-disk side effect ────────────────────────
# The generated files must not pre-exist, or the assertions below would pass
# against something this run did not do. This is what makes the check
# falsifiable rather than habitual — and it is not theoretical: `init` aborts
# with "already exists, delete it and run the command again" when they do, so
# a stale scratch would red here rather than silently pass.
ocx.mkdir(PROJ)
expect.false(ocx.exists(PROJ + "/.goreleaser.yaml"))
expect.false(ocx.exists(PROJ + "/.gitignore"))

r_init = ocx.run(GORELEASER, "init", cwd=PROJ)
expect.ok(r_init)

# Both files appeared, in the directory we pointed it at — a binary that merely
# printed "generating .goreleaser.yaml" could not produce this.
expect.true(ocx.exists(PROJ + "/.goreleaser.yaml"))
expect.true(ocx.exists(PROJ + "/.gitignore"))

# … and the file it wrote is a real goreleaser v2 config, not an empty stub.
expect.contains(ocx.read_file(PROJ + "/.goreleaser.yaml"), "version: 2")

# ── Tier 3b: config validation, POSITIVE direction ─────────────────────────
# Three distinct valid configs in one invocation. The count assertion is what
# makes this more than "exit 0": goreleaser logs one `checking` line per file,
# so a run that validated only the first argument and short-circuited green
# would report 1 and fail here. Counted across stdout+stderr rather than
# pinned to one stream, so the assertion does not depend on which handle the
# logger picks on a given OS.
ocx.write_file("one.yaml", cfg("one"))
ocx.write_file("two.yaml", cfg("two"))
ocx.write_file("three.yaml", cfg("three"))

r_ok = ocx.run(GORELEASER, "check", "one.yaml", "two.yaml", "three.yaml")
expect.ok(r_ok)
expect.eq((r_ok.stdout + r_ok.stderr).count("checking"), 3)

# ── Tier 3c: config validation, NEGATIVE direction (the negative control) ──
# `check` is a validator, and a validator that accepts everything is
# indistinguishable from `true` — every assertion above would still pass for a
# binary that exited 0 unconditionally. A structurally malformed config
# (`builds` as a scalar where a list is required) must be REJECTED.
ocx.write_file("bad.yaml", "version: 2\nproject_name: ocxsmoke\nbuilds: this-is-not-a-list\n")

r_bad = ocx.run(GORELEASER, "check", "bad.yaml")
expect.ne(r_bad.exit_code, 0)
